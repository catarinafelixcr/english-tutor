# copy this file to .env, and write your real key there
# .env is in .gitignore, so your key never goes to GitHub

# Which AI company answers: gemini, groq or ollama
AI_PROVIDER=gemini

# the model name 
# use a fixed version (not "latest"), so the AI grader does not change by itself
# if you get "Error code: 404", run: python scripts/check_ai.py  (it lists the Flash models your key can use)
AI_MODEL=gemini-3.5-flash-lite

# The address of the AI. Change this line to switch provider:
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
#   Groq:   https://api.groq.com/openai/v1
#   Ollama: http://localhost:11434/v1
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Your secret key. Leave it empty here. Write the real one only in .env
AI_API_KEY=